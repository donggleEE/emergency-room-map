        {
            "label": "Python 문법 검사",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "py_compile",
                "01_preprocess_er_data.py",
                "02_visualization_app.py",
                "03_realtime_data.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
